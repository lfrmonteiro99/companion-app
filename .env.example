# Optional. The default LLM target is a LOCAL Ollama server, which needs no
# key — leave this unset for the default setup. Only set it if you point
# --llm-base-url / AWARENESS_LLM_BASE_URL at an endpoint that enforces auth;
# it is then sent as a bearer token.
# AWARENESS_LLM_API_KEY=

# Optional overrides. CLI flags take precedence if both set.
# See config.example.toml for richer, non-secret configuration.

# AWARENESS_OUTPUT_DIR=data/phase_poc
# AWARENESS_LOG_LEVEL=info
# AWARENESS_BUDGET_USD=0.50
# AWARENESS_TICK_SCREEN_SECONDS=2
# AWARENESS_TICK_ANALYSIS_SECONDS=10
# AWARENESS_WHISPER_MODEL=models/ggml-base.bin
# AWARENESS_A11Y_SCRIPT=../../scripts/a11y_dump.py
# AWARENESS_MIN_SEND_INTERVAL_SECONDS=15
